APP_NAME=Amrutam Telemedicine API
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://amrutam:CHANGE_ME@localhost:5432/amrutam
REDIS_URL=redis://localhost:6379/0

